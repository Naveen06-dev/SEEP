{
  "manifest_version": 3,
  "name": "NeoExamShield",
  "version": "1.1.0",
  "description": "NeoExamShield - Prevents malpractice by blocking unauthorized extensions and websites during tests on the portal.",
  "permissions": [
    "management",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://localhost:3000/*",
    "http://localhost:4000/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "http://localhost:4000/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:4000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
