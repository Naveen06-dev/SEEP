{
  "manifest_version": 3,
  "name": "t_e",
  "version": "1.0.0",
  "description": "t_e Test Environment Extension - Automatically turns off all other browser extensions to allow secure exam starting.",
  "permissions": [
    "management",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://localhost:3000/*",
    "http://localhost:4000/*",
    "http://127.0.0.1:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "http://localhost:4000/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
