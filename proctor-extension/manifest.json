{
  "manifest_version": 3,
  "name": "SEEP Exam Proctor Security",
  "version": "1.0",
  "description": "Enforces exam integrity by disabling unauthorized extensions during tests on SEEP.",
  "permissions": [
    "management",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
